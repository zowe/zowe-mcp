{
  "name": "zowe-mcp",
  "version": "0.10.0",
  "private": true,
  "description": "Zowe MCP - Model Context Protocol server and VS Code extension for z/OS",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build-and-install": "npm run build-and-install -w packages/zowe-mcp-vscode",
    "build": "npm run build --workspaces",
    "call-tool": "npx @zowe/mcp-server call-tool",
    "check-format": "prettier --check \"**/*.{ts,mts,js,mjs,cjs,json,jsonc,yaml,yml,css,html}\" && node scripts/shfmt-write.mjs --check",
    "cloc": "cloc --vcs git .",
    "duplication": "jscpd ./packages",
    "eval-compare": "npm run build -w @zowe/mcp-server && npm run build -w packages/zowe-mcp-evals && node packages/zowe-mcp-evals/dist/eval-compare.js",
    "evals": "npm run build -w @zowe/mcp-server && npm run build -w packages/zowe-mcp-evals && npm run evals -w packages/zowe-mcp-evals -- \"$@\"",
    "list-eval-models": "npm run build -w packages/zowe-mcp-evals && npm run list-eval-models -w packages/zowe-mcp-evals --",
    "smoke:gemini-zowe-mcp": "npm run build -w @zowe/mcp-server && npm run build -w packages/zowe-mcp-evals && npm run smoke:gemini-zowe-mcp -w packages/zowe-mcp-evals",
    "smoke:claude-code": "npm run build -w @zowe/mcp-server && npm run build -w packages/zowe-mcp-evals && npm run smoke:claude-code -w packages/zowe-mcp-evals",
    "format": "prettier --write \"**/*.{ts,mts,js,mjs,cjs,json,jsonc,yaml,yml,css,html}\" && node scripts/shfmt-write.mjs",
    "generate-cli-bridge-yaml": "node scripts/generate-cli-bridge-yaml.mjs",
    "zosmf:download-specs": "node scripts/download-zosmf-specs.mjs",
    "zosmf:download-specs-batch": "node scripts/download-zosmf-specs-batch.mjs",
    "generate-docs": "npm run build -w packages/zowe-mcp-common && npm run build -w @zowe/mcp-server && node packages/zowe-mcp-server/dist/index.js generate-docs",
    "inspector:mock": "npx @modelcontextprotocol/inspector node packages/zowe-mcp-server/dist/index.js --stdio --mock ./zowe-mcp-mock-data",
    "inspector:native": "dotenv -e .env -- npx @modelcontextprotocol/inspector node packages/zowe-mcp-server/dist/index.js -- --stdio --native --config native-config.json",
    "inspector": "npx @modelcontextprotocol/inspector node packages/zowe-mcp-server/dist/index.js --stdio",
    "lint:fix": "eslint --fix \"packages/**/*.ts\" --max-warnings 0",
    "lint": "eslint \"packages/**/*.ts\" --max-warnings 0 --cache",
    "lint:sarif": "eslint \"packages/**/*.ts\" -f @microsoft/eslint-formatter-sarif -o eslint-results.sarif --cache",
    "typecheck": "npm run build -w packages/zowe-mcp-common && npm run build -w @zowe/mcp-server && npm run typecheck --workspaces --if-present",
    "lint:md": "markdownlint-cli2",
    "markdownlint:fix": "markdownlint-cli2 --fix",
    "test:all": "npm run test --workspaces",
    "test:server": "npm run test -w @zowe/mcp-server",
    "test:native-stdio-e2e": "npm run test:native-stdio-e2e -w @zowe/mcp-server",
    "test:keycloak-jwt-e2e": "npm run test:keycloak-jwt-e2e -w @zowe/mcp-server",
    "test:vscode": "npm run test -w packages/zowe-mcp-vscode",
    "test": "npm run test -w @zowe/mcp-server",
    "validate-tool-calls": "npm run validate-tool-calls -w @zowe/mcp-server",
    "pack:server": "npm run build -w @zowe/mcp-server && npm pack -w @zowe/mcp-server --pack-destination .",
    "test:airgap": "npm run test:airgap -w @zowe/mcp-server",
    "test:airgap:build": "npm run test:airgap:build -w @zowe/mcp-server",
    "test:airgap:build:native": "npm run test:airgap:build:native -w @zowe/mcp-server",
    "ci:package-release": "bash scripts/package-release.sh",
    "sdk:release": "node scripts/sdk-switch.js release",
    "sdk:nightly": "node scripts/sdk-switch.js nightly",
    "sdk:pr": "node scripts/sdk-switch.js pr",
    "sdk:branch": "node scripts/sdk-switch.js branch",
    "sdk:fallback": "node scripts/sdk-switch.js fallback",
    "sdk:local": "node scripts/sdk-switch.js local",
    "prepare": "git config core.hooksPath .githooks",
    "vendor:extract": "remote=${VENDOR_REMOTE:?Set VENDOR_REMOTE=<git-remote>} && branch=${VENDOR_BRANCH:?Set VENDOR_BRANCH=<branch>} && git fetch \"$remote\" && git archive \"$remote/$branch\" vendor/ | tar -x && printf '*\\n' > vendor/.gitignore",
    "vendor:clean": "rm -rf vendor/",
    "start:remote-https-dev-native-zos": "bash scripts/start-remote-https-dev-native-zos.sh",
    "keycloak:dev-fresh": "bash scripts/keycloak-dev-fresh.sh",
    "local-registry:wipe-publish-dev": "bash scripts/local-registry-wipe-publish-dev.sh"
  },
  "devDependencies": {
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@vitest/eslint-plugin": "^1.6.24",
    "@wasm-fmt/shfmt": "^0.2.7",
    "cloc": "^2.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-headers": "^1.3.4",
    "jscpd": "^5.0.12",
    "markdown-table-formatter": "^1.7.0",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0"
  }
}
