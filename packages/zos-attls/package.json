{
  "name": "zos-attls",
  "version": "0.11.0-dev",
  "description": "AT-TLS awareness for the z/OS HTTP services: SIOCTTLSCTL query addon plus a fail-closed connection gate",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "native/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:zos": "node --test native/test.mjs",
    "format": "prettier --write \"**/*.{ts,mjs,json}\"",
    "check-format": "prettier --check \"**/*.{ts,mjs,json}\""
  },
  "keywords": [
    "zowe",
    "zos",
    "at-tls",
    "attls"
  ],
  "license": "EPL-2.0",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "node-addon-api": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
