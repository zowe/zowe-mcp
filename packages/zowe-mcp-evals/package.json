{
  "name": "zowe-mcp-evals",
  "version": "0.11.0-dev",
  "description": "AI evaluations for Zowe MCP data set/member tools",
  "type": "module",
  "main": "dist/run.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "evals": "node dist/run.js",
    "list-eval-models": "node dist/list-eval-models.js",
    "smoke:gemini-zowe-mcp": "node dist/gemini-zowe-mcp-smoke.js",
    "smoke:claude-code": "node dist/claude-code-smoke.js",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,js,json}\"",
    "check-format": "prettier --check \"**/*.{ts,js,json}\""
  },
  "keywords": [
    "zowe",
    "mcp",
    "evals",
    "evaluation"
  ],
  "license": "EPL-2.0",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.33",
    "@ai-sdk/google": "^4.0.34",
    "@ai-sdk/openai": "^4.0.33",
    "@ai-sdk/openai-compatible": "3.0.23",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^7.0.52",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.2.2",
    "markdown-table": "^3.0.4",
    "zowe-mcp-common": "*"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
