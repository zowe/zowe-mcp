{
  "dangerous": [
    {
      "id": "console-quiesce",
      "message": "QUIESCE stops system activity.",
      "pattern": "^QUIESCE\\b"
    },
    { "id": "console-halt", "message": "HALT stops the system.", "pattern": "^HALT\\b" },
    {
      "id": "console-z-eod",
      "message": "Z EOD terminates the system.",
      "pattern": "^Z\\s+EOD\\b"
    },
    {
      "id": "console-shutdown",
      "message": "SHUTDOWN stops the system.",
      "pattern": "^SHUTDOWN\\b"
    },
    {
      "id": "console-route-dangerous",
      "message": "ROUTE would send a system-stopping command (QUIESCE/HALT/Z EOD/SHUTDOWN) to another system.",
      "pattern": "^(RO|ROUTE)\\s+\\S+,\\s*(QUIESCE\\b|HALT\\b|Z\\s+EOD\\b|SHUTDOWN\\b)"
    }
  ],
  "elicit": [
    {
      "id": "console-set",
      "message": "SET and SETxxx commands (SETPROG, SETXCF, SETSMF, ...) modify system parameters.",
      "pattern": "^SET"
    },
    {
      "id": "console-t-set",
      "message": "T (SET) modifies system parameters.",
      "pattern": "^T\\s+"
    },
    {
      "id": "console-vary",
      "message": "VARY changes device/subsystem status.",
      "pattern": "^VARY\\b"
    },
    {
      "id": "console-cancel",
      "message": "CANCEL terminates address spaces.",
      "pattern": "^CANCEL\\b"
    },
    {
      "id": "console-force",
      "message": "FORCE terminates address spaces forcefully.",
      "pattern": "^FORCE\\b"
    },
    { "id": "console-stop", "message": "STOP terminates address spaces.", "pattern": "^STOP\\b" },
    { "id": "console-p", "message": "P (STOP) terminates address spaces.", "pattern": "^P\\s+" },
    {
      "id": "console-modify",
      "message": "MODIFY changes running programs.",
      "pattern": "^MODIFY\\b"
    },
    { "id": "console-f", "message": "F (MODIFY) changes running programs.", "pattern": "^F\\s+" },
    { "id": "console-start", "message": "START initiates started tasks.", "pattern": "^START\\b" },
    { "id": "console-s", "message": "S (START) initiates started tasks.", "pattern": "^S\\s+" },
    {
      "id": "console-route",
      "message": "ROUTE sends commands to other systems.",
      "pattern": "^ROUTE\\b"
    },
    {
      "id": "console-ro",
      "message": "RO (ROUTE) sends commands to other systems.",
      "pattern": "^RO\\s+"
    },
    { "id": "console-v", "message": "V (VARY) changes device/subsystem status.", "pattern": "^V\\s+" },
    { "id": "console-c", "message": "C (CANCEL) terminates address spaces.", "pattern": "^C\\s+" },
    {
      "id": "console-e",
      "message": "E (RESET) changes the performance attributes of running work.",
      "pattern": "^E\\s+"
    },
    {
      "id": "console-reply",
      "message": "REPLY answers an outstanding operator request (WTOR).",
      "pattern": "^REPLY\\b"
    },
    {
      "id": "console-r-reply",
      "message": "R (REPLY) answers an outstanding operator request (WTOR).",
      "pattern": "^R\\s+\\d"
    },
    { "id": "console-dump", "message": "DUMP takes a system dump.", "pattern": "^DUMP\\b" },
    {
      "id": "console-slip",
      "message": "SLIP sets, modifies, or deletes serviceability traps.",
      "pattern": "^SLIP\\b"
    },
    {
      "id": "console-config",
      "message": "CONFIG changes processor/storage configuration.",
      "pattern": "^CONFIG\\b"
    },
    {
      "id": "console-cf",
      "message": "CF (CONFIG) changes processor/storage configuration.",
      "pattern": "^CF\\s+"
    },
    {
      "id": "console-k",
      "message": "K (CONTROL) changes console configuration.",
      "pattern": "^K\\s+"
    },
    { "id": "console-mount", "message": "MOUNT allocates a volume to a device.", "pattern": "^MOUNT\\b" },
    { "id": "console-m-mount", "message": "M (MOUNT) allocates a volume to a device.", "pattern": "^M\\s+" },
    { "id": "console-unload", "message": "UNLOAD removes a volume from a device.", "pattern": "^UNLOAD\\b" },
    { "id": "console-u-unload", "message": "U (UNLOAD) removes a volume from a device.", "pattern": "^U\\s+" },
    { "id": "console-swap", "message": "SWAP performs dynamic device reconfiguration.", "pattern": "^SWAP\\b" },
    { "id": "console-g-swap", "message": "G (SWAP) performs dynamic device reconfiguration.", "pattern": "^G\\s+" },
    { "id": "console-switch", "message": "SWITCH switches SMF recording data sets.", "pattern": "^SWITCH\\b" },
    { "id": "console-i-switch", "message": "I (SWITCH) switches SMF recording data sets.", "pattern": "^I\\s+" },
    { "id": "console-chngdump", "message": "CHNGDUMP changes system dump options.", "pattern": "^(CHNGDUMP\\b|CD\\s+)" },
    { "id": "console-dumpds", "message": "DUMPDS manages dump data sets.", "pattern": "^(DUMPDS\\b|DD\\s+)" },
    { "id": "console-pageadd", "message": "PAGEADD adds page or swap data sets.", "pattern": "^(PAGEADD\\b|PA\\s+)" },
    { "id": "console-pagedel", "message": "PAGEDEL removes page or swap data sets.", "pattern": "^(PAGEDEL\\b|PD\\s+)" },
    { "id": "console-ioaction", "message": "IOACTION stops or resumes device I/O.", "pattern": "^(IOACTION\\b|IO\\s+)" }
  ],
  "safe": [
    { "id": "console-d-t", "pattern": "^D\\s+T\\b" },
    { "id": "console-display-t", "pattern": "^DISPLAY\\s+T\\b" },
    { "id": "console-d-a", "pattern": "^D\\s+A\\b" },
    { "id": "console-display-a", "pattern": "^DISPLAY\\s+A\\b" },
    { "id": "console-d-m", "pattern": "^D\\s+M\\b" },
    { "id": "console-display-m", "pattern": "^DISPLAY\\s+M\\b" },
    { "id": "console-d-iplinfo", "pattern": "^D\\s+IPLINFO\\b" },
    { "id": "console-display-iplinfo", "pattern": "^DISPLAY\\s+IPLINFO\\b" },
    { "id": "console-d-r", "pattern": "^D\\s+R\\b" },
    { "id": "console-display-r", "pattern": "^DISPLAY\\s+R\\b" },
    { "id": "console-d-j", "pattern": "^D\\s+J\\b" },
    { "id": "console-display-j", "pattern": "^DISPLAY\\s+J\\b" },
    { "id": "console-d-smf", "pattern": "^D\\s+SMF\\b" },
    { "id": "console-display-smf", "pattern": "^DISPLAY\\s+SMF\\b" },
    { "id": "console-d-asm", "pattern": "^D\\s+ASM\\b" },
    { "id": "console-display-asm", "pattern": "^DISPLAY\\s+ASM\\b" },
    { "id": "console-d-prog", "pattern": "^D\\s+PROG\\b" },
    { "id": "console-display-prog", "pattern": "^DISPLAY\\s+PROG\\b" },
    { "id": "console-d-parmlib", "pattern": "^D\\s+PARMLIB\\b" },
    { "id": "console-display-parmlib", "pattern": "^DISPLAY\\s+PARMLIB\\b" }
  ]
}
